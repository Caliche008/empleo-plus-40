# ============================================================
# Empleo Plus 40 — Backend. Copia a .env y rellena.
# NUNCA subas el .env real al repositorio.
# ============================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Base de datos (Neon / PostgreSQL) ---
# Cadena de conexión de Neon (Project → Connect). Incluye sslmode=require.
DATABASE_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require

# --- Proveedor de IA (intercambiable) ---
# Proveedor activo: gemini | openrouter | groq
IA_PROVIDER=gemini
IA_MODEL=gemini-flash-latest
# Claves (rellena solo la del proveedor que uses)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- País por defecto del piloto ---
PAIS_DEFECTO=CO

# --- Envíos reales (WhatsApp/correo). Debe ser true para enviar de verdad. ---
ENVIOS_REALES=false
