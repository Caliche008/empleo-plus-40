// Esquema de datos del perfil del candidato (fase 2: persistencia).
// La edad NO existe como campo: nunca se almacena ni se usa para filtrar o
// puntuar (compliance). `mostrarFechasAntiguas` deja que la persona controle la
// exposición de fechas antiguas. Todas las relaciones hijas usan
// `onDelete: Cascade` para que al borrar un Candidato se eliminen su objetivo,
// sus colecciones y sus documentos en un solo paso (R6).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Candidato {
  id                    String           @id @default(uuid())
  telefono              String?          @unique
  nombre                String?
  pais                  String           @default("CO")
  consentimiento        Boolean          @default(false)
  mostrarFechasAntiguas Boolean          @default(false)
  objetivo              ObjetivoLaboral?
  habilidades           Habilidad[]
  experiencias          Experiencia[]
  certificaciones       Certificacion[]
  idiomas               Idioma[]
  documentos            Documento[]
  creadoEn              DateTime         @default(now())
}

model ObjetivoLaboral {
  id             String    @id @default(uuid())
  candidatoId    String    @unique
  candidato      Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  rol            String
  sector         String?
  salarioMin     Int?
  modalidad      String? // presencial | hibrido | remoto
  ubicacion      String?
  disponibilidad String?
}

model Experiencia {
  id          String    @id @default(uuid())
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  cargo       String
  empresa     String?
  descripcion String
  logros      String[]
  desde       String? // texto libre; la persona decide mostrar fechas
  hasta       String?
}

model Habilidad {
  id          String    @id @default(uuid())
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  nombre      String
  nivel       String?
}

model Certificacion {
  id          String    @id @default(uuid())
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  nombre      String
  emisor      String?
  anio        String?
}

model Idioma {
  id          String    @id @default(uuid())
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  idioma      String
  nivel       String?
}

model Documento {
  id          String    @id @default(uuid())
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  tipo        String // cv-pdf | cv-docx | cv-imagen | audio
  url         String
  creadoEn    DateTime  @default(now())
}

// Vacante analizada (fase 2 del módulo). Guarda el TEXTO original pegado por la
// persona y el análisis de la IA, nunca datos de personas: la edad no existe
// como campo ni se infiere (compliance). `candidatoId` es opcional y suelto (sin
// FK a Candidato) para no tocar el modelo Candidato ni añadir complejidad; si el
// módulo de match necesita la relación se añadirá entonces como opcional.
model Vacante {
  id                String   @id @default(uuid())
  candidatoId       String?
  cargo             String
  textoOriginal     String
  obligatorios      String[]
  deseables         String[]
  habilidades       String[]
  experienciaPedida String?
  ubicacion         String?
  modalidad         String?
  salario           String?
  alertas           Alerta[]
  creadoEn          DateTime @default(now())
}

// Bandera roja detectada en una vacante. `onDelete: Cascade` para que al borrar
// una Vacante se eliminen sus alertas en un solo paso, igual que las relaciones
// hijas del Candidato.
model Alerta {
  id        String  @id @default(uuid())
  vacanteId String
  vacante   Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
  tipo      String // edad | salario-oculto | requisitos-inflados | otro
  detalle   String
}

// Match de compatibilidad perfil↔vacante. NO almacena edad, nombre, género ni
// fecha de nacimiento: el cálculo que lo produce nunca los recibe (compliance §2,
// R2). `desglose` y `brechas` son JSON con forma estable documentada en el diseño.
// `candidatoId`/`vacanteId` se guardan sueltos (sin FK), igual que
// `Vacante.candidatoId`, para no acoplar los modelos existentes; la existencia la
// valida el servicio de match contra los servicios de dominio (404), no una FK.
model Match {
  id            String   @id @default(uuid())
  candidatoId   String
  vacanteId     String
  puntaje       Int // 0..100 (entero)
  desglose      Json // DesgloseMatch
  cubiertos     String[] // requisitos de la vacante que el perfil SÍ cubre
  brechas       Json // BrechaMatch[]
  recomendacion String // 'postular' | 'postular-ajustes' | 'descartar'
  explicacion   String // resumen en lenguaje simple (de la IA o del respaldo)
  creadoEn      DateTime @default(now())

  // Columna vectorial de PREPARACIÓN para búsquedas semánticas futuras. En esta
  // fase SIEMPRE queda NULL: el cálculo compara vectores en memoria y no define
  // "el vector del par". Administrada por SQL crudo; cuando se use se
  // escribirá/leerá con $queryRaw/$executeRaw.
  // embedding Unsupported("vector(768)")?

  @@index([candidatoId])
  @@index([vacanteId])
}
